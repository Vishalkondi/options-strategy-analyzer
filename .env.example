# Copy this file to .env and fill in real values. Never commit .env.
#
# IMPORTANT: leaving the placeholder text below in place is NOT the same as
# leaving a value blank. The backend now detects placeholders and tells you
# so, but it still cannot fetch live data until these are real.

# ---------------------------------------------------------------------------
# Zerodha Kite Connect  (required for anything "live")
# Get these from https://developers.kite.trade/apps -> your app
# ---------------------------------------------------------------------------
OA_KITE_API_KEY=
OA_KITE_API_SECRET=

# On the Kite app page, set the Redirect URL to exactly:
#   http://127.0.0.1:8000/api/kite/login-callback
# That endpoint exchanges the request_token and stores the access token for you.

# Optional legacy fallback: a manually pasted access token. Only used when the
# login flow has not been completed. The login flow supersedes this.
OA_KITE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Symbols shown on the live dashboard.
# OA_LIVE_MARKET_SYMBOLS=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK
# Seconds between dashboard pushes while a websocket client is connected.
# OA_LIVE_MARKET_INTERVAL=2
# Seconds between Kite historical calls. Kite allows ~3/sec; do not go below 0.34.
# OA_KITE_HISTORICAL_THROTTLE=0.34
# Max option contracts fetched per /api/live/sync call.
# OA_SYNC_MAX_CONTRACTS=20
# Strikes either side of ATM to sync when you don't pass explicit strikes.
# OA_SYNC_STRIKE_WINDOW=5
# How long the NSE/NFO instrument dump is cached, in seconds.
# OA_INSTRUMENT_TTL_SECONDS=21600

# OA_HOST=127.0.0.1
# OA_PORT=8000
# OA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# X (Twitter) sentiment lookups -- entirely optional
# ---------------------------------------------------------------------------
OA_X_API_BEARER_TOKEN=
